# meta-mcp environment template.
#
# meta-mcp never reads .env files itself. Load this file through your shell
# (set -a; . ./env.example; set +a), a systemd EnvironmentFile=, or your
# process manager. Every assignment below is commented out: uncomment and
# fill in only what you need. All values are placeholders, never real secrets.
#
# Precedence: process environment first, then credentials.json in META_MCP_HOME.
# `meta-mcp setup` fills credentials.json for you, so most deployments need
# only a few of these variables.

# ---------------------------------------------------------------- app
# Meta App ID (App Dashboard > Settings > Basic).
# META_APP_ID=123456789012345
# Meta App Secret (same page). Signs appsecret_proof and verifies webhook signatures.
# META_APP_SECRET=replace-with-app-secret
# Graph API version used in every request path (must look like v26.0).
# META_GRAPH_VERSION=v26.0
# Graph API base URL. Must be https unless the host is loopback (tests and proxies only).
# META_GRAPH_BASE_URL=https://graph.facebook.com

# -------------------------------------------------------------- pages
# Facebook Page access token. Replaces the pages stored in credentials.json with this one page.
# META_PAGE_ACCESS_TOKEN=replace-with-page-access-token
# Page ID for that token. When unset, the server resolves it with GET /me at startup.
# META_PAGE_ID=102938475610293

# ----------------------------------------------------------- whatsapp
# WhatsApp Cloud API access token (a System User token is recommended).
# META_WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-access-token
# Business phone number ID that sends and receives (not the phone number itself).
# META_WHATSAPP_PHONE_NUMBER_ID=106540352242922
# WhatsApp Business Account (Messaging account) ID.
# META_WABA_ID=102290129340398

# ------------------------------------------------------------ webhook
# Verify token Meta echoes during the webhook handshake. Generate one: openssl rand -hex 32
# META_WEBHOOK_VERIFY_TOKEN=replace-with-random-hex
# Public HTTPS URL of the webhook, as registered with Meta.
# META_WEBHOOK_PUBLIC_URL=https://hooks.example.org/webhook
# Address the webhook receiver binds (`meta-mcp webhook`).
# META_MCP_WEBHOOK_LISTEN=127.0.0.1:8787
# SQLite inbox file written by the webhook receiver and read by the MCP tools.
# META_MCP_INBOX_DB=/var/lib/meta-mcp/inbox.db

# ------------------------------------------------------------- server
# Directory holding credentials.json (default: the platform config directory for meta-mcp).
# META_MCP_HOME=/var/lib/meta-mcp
# Set to true to remove every tool that sends a message or changes local state.
# META_MCP_READ_ONLY=false
# Log filter in tracing EnvFilter syntax; logs go to stderr.
# META_MCP_LOG=meta_mcp=info

# -------------------------------------------------------------- files
# Directory the file tools may read from and write into. Unset disables file tools.
# Downloads are saved under inbound/messenger and inbound/whatsapp inside it. It must not contain
# META_MCP_HOME, credentials.json or the inbox database: startup fails and names the overlap.
# META_MCP_FILES_DIR=/var/lib/meta-mcp/files
# Largest file the file tools will read, upload or save, in bytes (default 100 MiB).
# META_MCP_MAX_FILE_BYTES=104857600
# Extra exact host names (no wildcards, no ports) that downloads may fetch from and that may
# receive the token. The Graph API host is refused whatever this says. Leave unset in
# production (see SECURITY.md).
# META_MCP_DOWNLOAD_HOSTS=

# --------------------------------------------------------------- http
# Comma-separated API keys for `meta-mcp http`, each at least 32 characters:
# generate one with: openssl rand -hex 32   (this placeholder is too short on purpose)
# META_MCP_API_KEYS=change-me
# Address and port `meta-mcp http` binds (loopback by default).
# META_MCP_HOST=127.0.0.1
# META_MCP_PORT=8788
# Extra Host header values accepted by the Host guard, comma-separated (host or host:port).
# META_MCP_ALLOWED_HOSTS=meta.example.org
